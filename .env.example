# ============================================
#   Claude Code Railway — Environment Variables
#   Copy ke Railway → Variables tab
#   (jangan commit file ini ke GitHub!)
# ============================================

# ── WAJIB ─────────────────────────────────────────────────────────────────

# API Key Anthropic (dari https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token
# Buat di: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Scope: repo, read:org, workflow
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password untuk akses VS Code di browser
# PENTING: code-server baca dari env var PASSWORD (bukan WEB_PASSWORD)
PASSWORD=ganti_dengan_password_kuat_kamu
WEB_PASSWORD=ganti_dengan_password_kuat_kamu

# ── GIT IDENTITY ──────────────────────────────────────────────────────────

GITHUB_NAME=Nama Kamu
GITHUB_EMAIL=kamu@email.com
